anagement\",\n          \"spec\": \"02-00-user-login\",\n          \"gate\": \"ready\"\n        },\n        \"reason\": \"需求填完后检查是否可进入实施\"\n      },\n      {\n        \"name\": \"summarize_save\",\n        \"args_template\": {\n          \"uri\": \"context://spec/01-user-management/02-00-user-login\",\n          \"l0\": \"<一句话摘要>\",\n          \"l1\": \"<约 2000 token 概览>\"\n        },\n        \"reason\": \"需求稳定后生成 L0/L1，便于跨 Spec 检索\"\n      }\n    ]\n  }\n}","metadata":{"truncated":false},"title":"","time":{"start":1788488563704,"end":1788488563741}},"id":"prt_06a39bb40001Zvwylul8JbMLMx","sessionID":"ses_f95c6867dffeljmlviUvLdd6z6","messageID":"msg_06a39b38d001FdHM1vasNdZh8Z"}}
